rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'howezhou2011@gmail.com';
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrapAdmin()
      );
    }

    // --- Validation Blueprints ---
    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid', 'role', 'displayName', 'encryptionMode',
          'keySalt', 'wrappedDek', 'wrappedDekIv', 'keyVersion',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'role', 'displayName', 'encryptionMode',
          'keySalt', 'wrappedDek', 'wrappedDekIv',
          'recoveryWrappedDek', 'recoveryWrappedDekIv',
          'keyVersion', 'disabled', 'suspendedReason', 'adminNote',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.role in ['student', 'educator', 'admin']
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.encryptionMode in ['passphrase', 'device-wrapped']
        && data.keySalt is string && data.keySalt.size() >= 16 && data.keySalt.size() <= 128
        && data.wrappedDek is string && data.wrappedDek.size() >= 16 && data.wrappedDek.size() <= 512
        && data.wrappedDekIv is string && data.wrappedDekIv.size() >= 12 && data.wrappedDekIv.size() <= 64
        && (!('recoveryWrappedDek' in data) || (data.recoveryWrappedDek is string && data.recoveryWrappedDek.size() >= 16 && data.recoveryWrappedDek.size() <= 512))
        && (!('recoveryWrappedDekIv' in data) || (data.recoveryWrappedDekIv is string && data.recoveryWrappedDekIv.size() >= 12 && data.recoveryWrappedDekIv.size() <= 64))
        && data.keyVersion is number && data.keyVersion >= 1 && data.keyVersion <= 1000
        && (!('disabled' in data) || data.disabled is bool)
        && (!('suspendedReason' in data) || (data.suspendedReason is string && data.suspendedReason.size() <= 280))
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEncryptedProfile(data) {
      return data.keys().hasAll(['ownerId', 'ciphertext', 'iv', 'alg', 'keyVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'ciphertext', 'iv', 'alg', 'keyVersion', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ciphertext is string && data.ciphertext.size() >= 1 && data.ciphertext.size() <= 65536
        && data.iv is string && data.iv.size() >= 12 && data.iv.size() <= 64
        && data.alg == 'AES-GCM-256'
        && data.keyVersion is number && data.keyVersion >= 1 && data.keyVersion <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEncryptedSyncDoc(data) {
      return data.keys().hasAll([
          'ownerId', 'app', 'chunkKey', 'chunkIndex', 'totalChunks',
          'ciphertext', 'iv', 'alg', 'checksum', 'deviceId', 'deviceName',
          'keyVersion', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'app', 'chunkKey', 'chunkIndex', 'totalChunks',
          'ciphertext', 'iv', 'alg', 'checksum', 'deviceId', 'deviceName',
          'keyVersion', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.app in ['revision', 'planner']
        && data.chunkKey is string && data.chunkKey.size() >= 1 && data.chunkKey.size() <= 150
        && data.chunkIndex is number && data.chunkIndex >= 0 && data.chunkIndex <= 500
        && data.totalChunks is number && data.totalChunks >= 1 && data.totalChunks <= 500
        && data.ciphertext is string && data.ciphertext.size() >= 1 && data.ciphertext.size() <= 400000
        && data.iv is string && data.iv.size() >= 12 && data.iv.size() <= 64
        && data.alg == 'AES-GCM-256'
        && data.checksum is string && data.checksum.size() >= 16 && data.checksum.size() <= 128
        && isValidId(data.deviceId)
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100
        && data.keyVersion is number && data.keyVersion >= 1 && data.keyVersion <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserDevice(data) {
      return data.keys().hasAll(['ownerId', 'deviceId', 'deviceName', 'platform', 'lastSeenAt', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'deviceId', 'deviceName', 'platform', 'lastSeenAt', 'createdAt'])
        && isValidId(data.ownerId)
        && isValidId(data.deviceId)
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 64
        && data.lastSeenAt is timestamp
        && data.createdAt is timestamp;
    }

    function isValidUserActivity(data) {
      return data.keys().hasAll(['ownerId', 'action', 'deviceName', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'action', 'deviceName', 'createdAt'])
        && isValidId(data.ownerId)
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 80
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 100
        && data.createdAt is timestamp;
    }

    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isRoomCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 8 && code.matches('^[A-Z0-9]+$');
    }

    function isValidSharedItemDoc(data) {
      return data.keys().hasAll([
          'id', 'shareCode', 'type', 'title', 'subjectName', 'examBoard',
          'summary', 'visibility', 'ownerId', 'ownerName', 'itemCount',
          'copyCount', 'payloadJson', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'shareCode', 'type', 'title', 'subjectName', 'examBoard',
          'summary', 'visibility', 'ownerId', 'ownerName', 'itemCount',
          'copyCount', 'payloadJson', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.shareCode is string && data.shareCode.size() >= 4 && data.shareCode.size() <= 16 && data.shareCode.matches('^[A-Z0-9]+$')
        && data.type in ['notes', 'flashcards', 'subject']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 80
        && data.examBoard is string && data.examBoard.size() >= 1 && data.examBoard.size() <= 80
        && data.summary is string && data.summary.size() <= 280
        && data.visibility in ['public', 'unlisted']
        && isValidId(data.ownerId)
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100
        && data.itemCount is number && data.itemCount >= 0 && data.itemCount <= 10000
        && data.copyCount is number && data.copyCount >= 0 && data.copyCount <= 1000000
        && data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 450000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuizDeckDoc(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'cardCount', 'sectionsJson', 'cardsJson', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'cardCount', 'sectionsJson', 'cardsJson', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.cardCount is number && data.cardCount >= 0 && data.cardCount <= 5000
        && data.sectionsJson is string && data.sectionsJson.size() >= 2 && data.sectionsJson.size() <= 50000
        && data.cardsJson is string && data.cardsJson.size() >= 2 && data.cardsJson.size() <= 650000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuizRoomDoc(data) {
      return data.keys().hasAll([
          'code', 'hostUid', 'deckId', 'deckTitle', 'selectedSectionsJson',
          'timerSeconds', 'status', 'totalQuestions', 'currentIndex',
          'currentQuestionJson', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'hostUid', 'deckId', 'deckTitle', 'selectedSectionsJson',
          'timerSeconds', 'status', 'totalQuestions', 'currentIndex', 'roundId',
          'questionStartedAt', 'questionEndsAt', 'currentQuestionJson',
          'createdAt', 'updatedAt'
        ])
        && isRoomCode(data.code)
        && isValidId(data.hostUid)
        && data.deckId is string && data.deckId.size() >= 1 && data.deckId.size() <= 128
        && data.deckTitle is string && data.deckTitle.size() >= 1 && data.deckTitle.size() <= 140
        && data.selectedSectionsJson is string && data.selectedSectionsJson.size() >= 2 && data.selectedSectionsJson.size() <= 50000
        && data.timerSeconds in [15, 20, 30]
        && data.status in ['lobby', 'question', 'reveal', 'finished']
        && data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 1000
        && data.currentIndex is number && data.currentIndex >= -1 && data.currentIndex <= 1000
        && (!('roundId' in data) || (data.roundId is string && data.roundId.size() <= 128))
        && (!('questionStartedAt' in data) || data.questionStartedAt == null || data.questionStartedAt is number)
        && (!('questionEndsAt' in data) || data.questionEndsAt == null || data.questionEndsAt is number)
        && data.currentQuestionJson is string && data.currentQuestionJson.size() >= 2 && data.currentQuestionJson.size() <= 50000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuizPlayerDoc(data) {
      return data.keys().hasAll([
          'id', 'uid', 'nickname', 'isHost', 'score', 'streak', 'bestStreak',
          'correctCount', 'connected', 'hasSubmitted', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'nickname', 'isHost', 'score', 'streak', 'bestStreak',
          'correctCount', 'connected', 'hasSubmitted', 'gradingStatus',
          'pendingAnswer', 'pendingSubmittedAt', 'pendingQuestionIndex',
          'pendingRoundId', 'lastSubmissionJson', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.uid)
        && data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 40
        && data.isHost is bool
        && data.score is number && data.score >= 0
        && data.streak is number && data.streak >= 0
        && data.bestStreak is number && data.bestStreak >= 0
        && data.correctCount is number && data.correctCount >= 0
        && data.connected is bool
        && data.hasSubmitted is bool
        && (!('gradingStatus' in data) || data.gradingStatus == null || data.gradingStatus in ['grading', 'done'])
        && (!('pendingAnswer' in data) || (data.pendingAnswer is string && data.pendingAnswer.size() <= 1000))
        && (!('pendingSubmittedAt' in data) || data.pendingSubmittedAt is number)
        && (!('pendingQuestionIndex' in data) || data.pendingQuestionIndex is number)
        && (!('pendingRoundId' in data) || (data.pendingRoundId is string && data.pendingRoundId.size() <= 128))
        && (!('lastSubmissionJson' in data) || data.lastSubmissionJson == null || (data.lastSubmissionJson is string && data.lastSubmissionJson.size() <= 10000))
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && !('disabled' in incoming())
        && !('suspendedReason' in incoming())
        && !('adminNote' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'student' || isBootstrapAdmin());

      allow update: if isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin()
            && !(userId == request.auth.uid && 'disabled' in incoming() && incoming().disabled == true)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'role', 'displayName', 'disabled', 'suspendedReason', 'adminNote', 'updatedAt'
            ])) ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'encryptionMode', 'keySalt', 'wrappedDek', 'wrappedDekIv',
              'recoveryWrappedDek', 'recoveryWrappedDekIv', 'keyVersion', 'updatedAt'
            ]))
        );

      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidEncryptedProfile(incoming())
          && incoming().ownerId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && isValidEncryptedProfile(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'ciphertext', 'iv', 'alg', 'keyVersion', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || (isAdmin() && userId != request.auth.uid));
      }

      match /syncDocs/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid) || (isAdmin() && resource.data.ownerId == userId);

        allow create: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidEncryptedSyncDoc(incoming())
          && incoming().ownerId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(docId)
          && isOwner(userId)
          && isValidEncryptedSyncDoc(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().app == existing().app
          && incoming().chunkKey == existing().chunkKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'chunkIndex', 'totalChunks', 'ciphertext', 'iv', 'alg',
            'checksum', 'deviceId', 'deviceName', 'keyVersion', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || (isAdmin() && userId != request.auth.uid));
      }

      match /devices/{deviceId} {
        allow get: if isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid) || (isAdmin() && resource.data.ownerId == userId);

        allow create: if isValidId(userId)
          && isValidId(deviceId)
          && isOwner(userId)
          && isValidUserDevice(incoming())
          && incoming().ownerId == userId
          && incoming().deviceId == deviceId
          && incoming().createdAt == request.time
          && incoming().lastSeenAt == request.time;

        allow update: if isValidId(userId)
          && isValidId(deviceId)
          && isOwner(userId)
          && isValidUserDevice(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().deviceId == existing().deviceId
          && incoming().createdAt == existing().createdAt
          && incoming().lastSeenAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'deviceName', 'platform', 'lastSeenAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(deviceId) && (isOwner(userId) || (isAdmin() && userId != request.auth.uid));
      }

      match /activity/{activityId} {
        allow get: if isValidId(userId) && isValidId(activityId) && (isOwner(userId) || isAdmin());
        allow list: if (isOwner(userId) && resource.data.ownerId == request.auth.uid) || (isAdmin() && resource.data.ownerId == userId);

        allow create: if isValidId(userId)
          && isValidId(activityId)
          && isOwner(userId)
          && isValidUserActivity(incoming())
          && incoming().ownerId == userId
          && incoming().createdAt == request.time;

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(activityId) && (isOwner(userId) || (isAdmin() && userId != request.auth.uid));
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminRole(incoming())
        && incoming().uid == userId
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }

    match /sharedItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if request.query.limit <= 300;

      allow create: if isValidId(itemId)
        && isVerified()
        && isValidSharedItemDoc(incoming())
        && incoming().id == itemId
        && incoming().ownerId == request.auth.uid
        && incoming().copyCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(itemId) && (
        (
          isVerified()
          && (existing().ownerId == request.auth.uid || isAdmin())
          && isValidSharedItemDoc(incoming())
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'subjectName', 'examBoard', 'summary', 'visibility',
            'ownerName', 'itemCount', 'payloadJson', 'updatedAt'
          ])
        ) || (
          isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['copyCount'])
          && incoming().copyCount is number
          && incoming().copyCount == existing().copyCount + 1
        )
      );

      allow delete: if isValidId(itemId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /quizDecks/{deckId} {
      allow get: if isValidId(deckId) && isSignedIn() && (
        resource == null || existing().ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isValidId(deckId)
        && isSignedIn()
        && isValidQuizDeckDoc(incoming())
        && incoming().id == deckId
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(deckId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid
        && isValidQuizDeckDoc(incoming())
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(deckId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /quizRooms/{roomCode} {
      allow get: if isRoomCode(roomCode) && isSignedIn();
      allow list: if false;

      allow create: if isRoomCode(roomCode)
        && isSignedIn()
        && isValidQuizRoomDoc(incoming())
        && incoming().code == roomCode
        && incoming().hostUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isRoomCode(roomCode)
        && isSignedIn()
        && existing().hostUid == request.auth.uid
        && isValidQuizRoomDoc(incoming())
        && incoming().code == existing().code
        && incoming().hostUid == existing().hostUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isRoomCode(roomCode) && isSignedIn() && existing().hostUid == request.auth.uid;

      match /players/{playerId} {
        allow get: if isRoomCode(roomCode) && isValidId(playerId) && isSignedIn();
        allow list: if isRoomCode(roomCode) && isSignedIn();

        allow create: if isRoomCode(roomCode)
          && isValidId(playerId)
          && isSignedIn()
          && isValidQuizPlayerDoc(incoming())
          && incoming().id == playerId
          && incoming().uid == request.auth.uid
          && incoming().updatedAt == request.time;

        allow update: if isRoomCode(roomCode)
          && isValidId(playerId)
          && isSignedIn()
          && isValidQuizPlayerDoc(incoming())
          && incoming().id == existing().id
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && (
            existing().uid == request.auth.uid ||
            get(/databases/$(database)/documents/quizRooms/$(roomCode)).data.hostUid == request.auth.uid
          );

        allow delete: if isRoomCode(roomCode)
          && isValidId(playerId)
          && isSignedIn()
          && (
            existing().uid == request.auth.uid ||
            get(/databases/$(database)/documents/quizRooms/$(roomCode)).data.hostUid == request.auth.uid
          );
      }
    }
  }
}
